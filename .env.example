# Vorlage — echte Werte in .env.local (lokal) bzw. in den Vercel-Umgebungsvariablen.

# Supabase (EU): Projekt-URL + Publishable Key (kein Geheimnis) und das
# Ingest-Token (Geheimnis! nur Server-seitig; muss dem Wert in der
# DB-Tabelle ingest_config entsprechen).
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
MEASUREMENT_INGEST_TOKEN=<64 zufällige Hex-Zeichen>

# Messserver (Peer). Zielhost = TARGETS[0] + "." + TLD, z. B. dev.localhost.
# Lokal: Docker-Peer (infra/dev-peer), unverschlüsselt.
# Produktion: wss auf Port 443 gegen den Frankfurt-Peer (Phase 1, PR 3).
NEXT_PUBLIC_IAS_WS_TARGETS=dev
NEXT_PUBLIC_IAS_WS_TLD=localhost
NEXT_PUBLIC_IAS_WS_PORT=8081
NEXT_PUBLIC_IAS_WS_TLS=0

# Zugangs-Gate: gesetzt = App nur mit diesem Code nutzbar (bis zum Launch).
# Nicht gesetzt = offen (lokale Entwicklung).
# ACCESS_CODE=<einladungscode>

# Rechnungs-Scan (Phase 4). Geheimnis! Nur Server-seitig — der Schlüssel darf
# NIE in den Browser gelangen, deshalb ohne NEXT_PUBLIC_-Präfix.
# Nicht gesetzt = der Scan ist aus, die App bleibt vollständig benutzbar
# (Tarif wird dann wie bisher ausgewählt).
# ANTHROPIC_API_KEY=sk-ant-...

# Wechsel-Partner (Phase 6). Beide nicht gesetzt = kein Wechsel-Vorschlag im
# Ergebnis — der Normalzustand, bis das Partnerkonto steht (braucht Impressum,
# also Phase 8). Die echte Adresse kommt aus dem Partnerkonto; hier steht sie
# als Vorlage, damit im Repo keine geratene Partnerkennung landet.
# Pflicht-Platzhalter: {klick_id}. Optional: {anbieter}, {mbps}.
# Nur Server-seitig (kein NEXT_PUBLIC_) — die Partnerkennung gehört nicht ins
# Browser-Bundle.
# WECHSEL_PARTNER_NAME=CHECK24
# WECHSEL_PARTNER_URL=https://<partner-adresse>?subid={klick_id}
