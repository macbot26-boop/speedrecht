{
  "name": "breitband-messwerkstatt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Validierungs-Setup: Wie gut kann eine Browser-/PWA-Speedmessung im Vergleich zur LAN-Referenz sein?",
  "scripts": {
    "start": "node server.mjs",
    "build:engine": "esbuild src/engine-entry.js --bundle --minify --format=iife --outfile=public/vendor/cf-speedtest.js",
